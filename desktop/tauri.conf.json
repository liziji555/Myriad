{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Myriad",
  "mainBinaryName": "superagent-desktop",
  "version": "0.1.1",
  "identifier": "io.github.liziji555.superagent",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "shortDescription": "房间里的 AI 团队",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
